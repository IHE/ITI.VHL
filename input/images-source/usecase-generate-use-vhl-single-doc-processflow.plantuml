@startuml
skinparam svgDimensionStyle false
hide footbox
participant "VHL Sharer" as VHLS
participant "VHL Holder" as VHLH
participant "VHL Receiver" as VHLR

activate VHLH
activate VHLS


VHLH -> VHLS : Generate VHL request [ITI-YY3]
VHLS -> VHLH : Generate VHL response [ITI-YY3]

activate VHLR
VHLH -> VHLR : Provide VHL  [ITI-YY4]
VHLR -> VHLS : Retrieve Manifest request [ITI-YY5]
VHLS -> VHLR : Retrieve Manifest response [ITI-YY5]


@enduml
