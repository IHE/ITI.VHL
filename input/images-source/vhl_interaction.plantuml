@startuml
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 55
skinparam defaultFontSize 12
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #2B2B2B
  FontColor #000000
}
top to bottom direction

rectangle "VHL Sharer" as VHLS
rectangle "VHL Holder" as H
rectangle "VHL Receiver" as VHLR

url of H is [[ActorDefinition-VHLHolder.html]]
url of VHLR is [[ActorDefinition-VHLReceiver.html]]
url of VHLS is [[ActorDefinition-VHLSharer.html]]

VHLS -- H : "  Generate VHL [ITI-YY3]"
H -- VHLR : "  Provide VHL [ITI-YY4]"
VHLS -- VHLR : "  Retrieve Manifest [ITI-YY5]"
@enduml
