@startuml
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 55
skinparam defaultFontSize 12
skinparam rectangle {
  BackgroundColor #FFFFFF
  BorderColor #2B2B2B
  FontColor #000000
}
top to bottom direction

rectangle "VHL Sharer" as TrustVHLS
rectangle "Trust Anchor" as TA
rectangle "VHL Receiver" as TrustVHLR

url of TA is [[ActorDefinition-TrustAnchor.html]]
url of TrustVHLR is [[ActorDefinition-VHLReceiver.html]]
url of TrustVHLS is [[ActorDefinition-VHLSharer.html]]

TrustVHLS -- TA : "  Submit PKI Material with DID [ITI-YY1]\n  Retrieve Trust List with DID [ITI-YY2]"
TA -- TrustVHLR : "  Submit PKI Material with DID [ITI-YY1]\n  Retrieve Trust List with DID [ITI-YY2]"
@enduml
